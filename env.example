# .env
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — add it to .gitignore

# ── Blockchain ────────────────────────────────────────────────────────────────

# RPC URL — use Ganache for development
# Ganache GUI default: http://127.0.0.1:7545
# Ganache CLI default: http://127.0.0.1:8545
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545

# Deployed contract address (printed by deploy.js after running)
BLOCKCHAIN_CONTRACT_ADDRESS=0xYourContractAddressHere

# Admin wallet — copy from Ganache "Accounts" tab
BLOCKCHAIN_ADMIN_ADDRESS=0x90F8bf6A479f320ead074411a4B0e7944Ea8c9C1

# Admin private key — copy from Ganache (click key icon next to account)
# ⚠️  NEVER share this or commit it to git
BLOCKCHAIN_ADMIN_PRIVATE_KEY=0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d

# Chain ID: 1337=Ganache, 80001=Mumbai testnet, 11155111=Sepolia testnet
BLOCKCHAIN_CHAIN_ID=1337

# ── Mailer (for fraud alert emails) ──────────────────────────────────────────
# Already in your Rails app — just ensure ADMIN_EMAIL is set
ADMIN_EMAIL=admin@yourplatform.com
